---
const steps = [
  {
    title: "Natural Language Specification",
    example: "当 req 有效后，下一个周期必须出现 ack。",
  },
  {
    title: "LLM",
    example: "理解自然语言约束并转换成形式化属性。",
  },
  {
    title: "Formal Property / SVA",
    example: "@(posedge clk) req |=> ack;",
  },
  {
    title: "Formal Verification",
    example: "Formal Tool 检查该性质是否对所有合法状态成立。",
  },
  {
    title: "Counterexample",
    example: "如果 Property 失败，则返回违反性质的执行轨迹。",
  },
  {
    title: "Property Repair",
    example: "LLM 根据 Counterexample 修正 Property 或 Specification。",
  },
]
---

<div class="not-prose my-8">
  <div
    class="rounded-xl border border-black/10 p-5 dark:border-white/10"
  >
    <div class="mb-6">
      <div class="font-semibold">
        Natural Language → SystemVerilog Assertion
      </div>

      <p class="mt-1 text-sm opacity-60">
        LLM-assisted formal property generation
      </p>
    </div>

    <div class="flex flex-col items-center">
      {
        steps.map((step, index) => (
          <>
            <details
              class="w-full rounded-lg border border-black/10 px-4 py-3 dark:border-white/10"
            >
              <summary class="cursor-pointer font-medium">
                {step.title}
              </summary>

              {step.title === "Formal Property / SVA" ? (
                <pre class="mt-3 overflow-x-auto rounded-lg bg-black/5 p-3 text-sm dark:bg-white/5"><code>{step.example}</code></pre>
              ) : (
                <p class="mb-0 mt-3 text-sm leading-6 opacity-70">
                  {step.example}
                </p>
              )}
            </details>

            {index !== steps.length - 1 && (
              <div class="py-2 opacity-40">
                ↓
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>
</div>