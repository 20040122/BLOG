---
interface Props {
  title: string;
  venue?: string;
  year?: string | number;
  authors?: string;
  image?: string;
  paper?: string;
  code?: string;
  arxiv?: string;
  description?: string;
}

const {
  title,
  venue,
  year,
  authors,
  image,
  paper,
  code,
  arxiv,
  description,
} = Astro.props;
---

<div class="not-prose my-8 overflow-hidden rounded-xl border border-black/10
            bg-white/50 transition-colors
            dark:border-white/10 dark:bg-white/[0.03]">

  <div class="grid gap-0 md:grid-cols-[370px_1fr]">

    {
      image && (
        <div class="overflow-hidden bg-black/5 dark:bg-white/5">
          <button type="button" data-zoom-src={image} data-zoom-alt={`${title} architecture`} aria-label="Zoom image" class="block h-full min-h-[200px] w-full cursor-zoom-in border-0 bg-transparent p-0">
            <img
              src={image}
              alt={`${title} architecture`}
              class="h-full w-full object-contain"
              loading="lazy"
            />
          </button>
        </div>
      )
    }

    <div class="flex flex-col p-5">

      <h3 class="m-0 text-lg font-semibold tracking-tight">
        {title}
      </h3>

      {
        (venue || year) && (
          <div class="mt-2 text-sm font-medium opacity-70">
            {venue}
            {venue && year && <span> · </span>}
            {year}
          </div>
        )
      }

      {
        authors && (
          <div class="mt-1 text-sm opacity-60">
            {authors}
          </div>
        )
      }

      {
        description && (
          <p class="mt-3 text-sm leading-relaxed opacity-80">
            {description}
          </p>
        )
      }

      <div class="mt-auto flex flex-wrap gap-2 pt-4">

        {
          paper && (
            <a
              href={paper}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md border px-3 py-1.5 text-sm no-underline
                     transition hover:bg-black/5
                     dark:hover:bg-white/10"
            >
              Paper ↗
            </a>
          )
        }

        {
          arxiv && (
            <a
              href={arxiv}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md border px-3 py-1.5 text-sm no-underline
                     transition hover:bg-black/5
                     dark:hover:bg-white/10"
            >
              arXiv ↗
            </a>
          )
        }

        {
          code && (
            <a
              href={code}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md border px-3 py-1.5 text-sm no-underline
                     transition hover:bg-black/5
                     dark:hover:bg-white/10"
            >
              Code ↗
            </a>
          )
        }

      </div>
    </div>

  </div>
</div>

<script is:inline>
  if (!window.__zoomInit) {
    window.__zoomInit = true;
    document.addEventListener("click", function (e) {
      var b = e.target.closest && e.target.closest("[data-zoom-src]");
      if (!b) return;
      var dlg = document.getElementById("img-lightbox");
      if (!dlg) {
        dlg = document.createElement("dialog");
        dlg.id = "img-lightbox";
        dlg.style.cssText = "padding:0;border:0;background:transparent;max-width:none;max-height:none;overflow:visible";
        var img = document.createElement("img");
        img.style.cssText = "max-width:92vw;max-height:92vh;object-fit:contain;background:#fff;border-radius:8px;cursor:zoom-out;display:block";
        dlg.appendChild(img);
        dlg.addEventListener("click", function () { dlg.close(); });
        var st = document.createElement("style");
        st.textContent = "#img-lightbox::backdrop{background:rgba(0,0,0,.8)}";
        document.head.appendChild(st);
        document.body.appendChild(dlg);
      }
      var im = dlg.querySelector("img");
      im.src = b.getAttribute("data-zoom-src");
      im.alt = b.getAttribute("data-zoom-alt") || "";
      dlg.showModal();
    });
  }
</script>
