---
import type { MarkdownHeading } from "astro"
import { buildTocTree } from "@lib/toc"

type Props = {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const lines = buildTocTree(headings)
// A 0-1 line "tree" is noise: skip the sidebar and its script entirely
const visible = lines.length >= 2
const BAR_CELLS = 20
---

{visible &&
  <aside
    id="article-toc"
    class="hidden xl:block fixed top-1/2 -translate-y-1/2 left-6 w-52 2xl:w-64 z-40 font-mono text-xs leading-5 text-gray-700 dark:text-gray-300 flex flex-col max-h-[calc(100vh-8rem)]"
    aria-label="Table of contents"
  >
    <div class="select-none mb-1">TREE</div>
    <nav class="overflow-y-auto min-h-0">
      {lines.map(line => (
        <a href={`#${line.slug}`} data-slug={line.slug} data-conn={line.connector} class="block whitespace-pre overflow-hidden text-ellipsis hover:text-black dark:hover:text-white transition-colors duration-200">{line.prefix}<span class="toc-conn">{line.connector}</span>{" " + line.text}</a>
      ))}
    </nav>
    <div id="toc-progress" class="mt-2 shrink-0 whitespace-pre select-none">{"░".repeat(BAR_CELLS) + " 0%"}</div>
  </aside>
}
{visible && <script is:inline defer src="/js/toc.js"></script>}
