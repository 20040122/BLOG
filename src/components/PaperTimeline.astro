---
interface TimelinePaper {
  year: number | string;
  title: string;
  venue: string;
  authors?: string;
  description?: string;
  tag?: string;
  paper?: string;
  arxiv?: string;
  code?: string;
}

interface Props {
  papers: TimelinePaper[];
}

const { papers } = Astro.props;
const lastIndex = papers.length - 1;

const linkClass =
  "text-black/55 no-underline underline-offset-4 transition-colors hover:text-black hover:underline decoration-black/30 dark:text-white/55 dark:hover:text-white dark:decoration-white/30";
---

<section class="not-prose my-10" aria-label="论文时间轴">
  <ol class="relative m-0 list-none p-0">
    {
      papers.map((p, i) => {
        const isFirst = i === 0;
        const isLast = i === lastIndex;
        return (
          <li class="group relative pb-9 pl-10 last:pb-0 md:pl-32">
            {/* rail */}
            <span
              aria-hidden="true"
              class:list={[
                "absolute left-[9px] w-0.5 bg-black/10 dark:bg-white/10 md:left-[103px]",
                isFirst ? "top-3" : "top-0",
                isLast ? "h-3" : "bottom-0",
              ]}
            />

            {/* node */}
            <span
              aria-hidden="true"
              class:list={[
                "absolute left-1 top-1.5 z-10 h-3 w-3 rounded-full ring-4 ring-white transition-colors duration-300 dark:ring-black md:left-[98px]",
                isLast
                  ? "bg-black dark:bg-white"
                  : "bg-neutral-400 group-hover:bg-neutral-700 dark:bg-neutral-500 dark:group-hover:bg-white",
              ]}
            />

            {/* year gutter (desktop) */}
            <div class="hidden md:absolute md:left-0 md:top-[3px] md:block md:w-20 md:text-right">
              <span class="text-base font-semibold tabular-nums text-black/50 transition-colors group-hover:text-black dark:text-white/50 dark:group-hover:text-white">
                {p.year}
              </span>
            </div>

            <div class="rounded-xl border border-black/10 bg-white/50 p-4 transition-colors duration-300 hover:border-black/20 hover:bg-black/[0.02] dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-white/20 dark:hover:bg-white/[0.06]">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center rounded-full border border-black/10 px-2 py-0.5 text-[11px] font-medium uppercase tracking-wide text-black/60 dark:border-white/15 dark:text-white/60">
                  <span class="md:hidden">{p.year} ·&nbsp;</span>
                  {p.venue}
                </span>
                {p.tag && (
                  <span class="text-[11px] tracking-wide text-black/40 dark:text-white/40">
                    {p.tag}
                  </span>
                )}
              </div>

              <h3 class="mb-0 mt-2 text-base font-semibold leading-snug text-black dark:text-white">
                {p.paper ? (
                  <a
                    href={p.paper}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-inherit no-underline decoration-black/30 underline-offset-4 hover:underline dark:decoration-white/30"
                  >
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
              </h3>

              {p.authors && (
                <p class="mb-0 mt-1 text-xs leading-relaxed text-black/50 dark:text-white/50">
                  {p.authors}
                </p>
              )}

              {p.description && (
                <p class="mb-0 mt-2 text-sm leading-relaxed text-black/70 dark:text-white/70">
                  {p.description}
                </p>
              )}

              {(p.arxiv || p.code) && (
                <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
                  {p.arxiv && (
                    <a
                      href={p.arxiv}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={linkClass}
                    >
                      arXiv ↗
                    </a>
                  )}
                  {p.code && (
                    <a
                      href={p.code}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={linkClass}
                    >
                      Code ↗
                    </a>
                  )}
                </div>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
